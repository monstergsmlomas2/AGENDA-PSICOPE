# Base de datos PostgreSQL (Supabase)
DATABASE_URL=postgresql://postgres:password@db.tu-proyecto.supabase.co:5432/postgres

# Supabase JWT Secret (Settings > API > JWT Secret)
# Se usa para verificar los tokens JWT de Supabase Auth en el servidor
SUPABASE_JWT_SECRET=tu-jwt-secret-aqui

# Puerto del servidor (opcional, default: 3000)
# PORT=3000

# URL del cliente para CORS (opcional)
# CLIENT_URL=https://agenda-psicope.vercel.app

# ── Número central del sistema (Agenda Psicope) ──────────────────────────────
# Activa el envío del resumen diario al profesional desde un número WhatsApp
# central (de los desarrolladores) en vez del número de cada profesional, para
# que la notificación SUENE (WhatsApp no notifica "mensajes contigo mismo").
# "true" para activar; cualquier otro valor / ausente = comportamiento previo.
WHATSAPP_SISTEMA_ENABLED=false
# Llave secreta de las rutas de admin (/admin/sistema/*) para conectar y ver el QR
# del número central. Generá una larga y aleatoria. Header: x-admin-secret.
ADMIN_SECRET=cambia-esto-por-una-clave-larga-y-secreta
